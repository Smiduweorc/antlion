{
	"name": "antlion-lacewing",
	"version": "0.0.0",
	"description": "DPoP (RFC 9449) proof verification for Lacewing: one call checks the access token, the proof and the key binding together, or rejects the request.",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"main": "dist/index.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/index.js"
		},
		"./legacy": {
			"types": "./dist/types/legacy.d.ts",
			"default": "./dist/legacy.js"
		},
		"./node": {
			"types": "./dist/types/node.d.ts",
			"default": "./dist/node.js"
		}
	},
	"files": [
		"dist",
		"NOTICE.md"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "node --import tsx --test \"tests/**/*.test.ts\"",
		"test:dist": "npm run build && node --test \"tests/dist/*.test.js\"",
		"compliance": "node --import tsx tools/run-compliance.ts",
		"bench": "node --import tsx tools/bench.ts",
		"docs": "typedoc",
		"changelog": "git-cliff -o CHANGELOG.md",
		"prepare": "lefthook install",
		"prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run compliance && npm run test:dist"
	},
	"keywords": [
		"dpop",
		"rfc9449",
		"oauth",
		"jwt",
		"fapi",
		"lacewing",
		"security",
		"typescript"
	],
	"author": "Smiduweorc",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Smiduweorc/antlion.git"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@types/express": "^5.0.6",
		"@types/koa": "^3.0.3",
		"@types/koa-mount": "^4.0.5",
		"@types/node": "^26.6.3",
		"eslint": "^10.11.0",
		"express": "^5.2.1",
		"fast-check": "^4.10.2",
		"fastify": "^5.12.5",
		"git-cliff": "^2.14.2",
		"koa": "^3.2.1",
		"koa-mount": "^4.2.0",
		"lacewing": "^1.2.0",
		"lefthook": "^2.1.14",
		"oauth4webapi": "^3.8.8",
		"tsx": "^4.23.15",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1"
	},
	"peerDependencies": {
		"lacewing": "^1.2.0"
	},
	"dependencies": {
		"jose": "^6.2.12"
	}
}
