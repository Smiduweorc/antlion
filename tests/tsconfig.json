{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": "..",
		"types": ["node"]
	},
	"include": [
		"./**/*.ts",
		"../index.ts",
		"../legacy.ts",
		"../node.ts",
		"../redis.ts",
		"../postgres.ts",
		"../src/**/*.ts",
		"../tools/**/*.ts"
	],
	"exclude": [
		"../node_modules",
		"../dist",
		"./types/fixtures/**"
	]
}
